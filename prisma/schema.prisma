generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved the connection URL out of the schema — see prisma.config.ts.
datasource db {
  provider = "sqlite"
}

/// Key/value application settings edited from the Cài đặt screen — API keys and
/// the brand icon. They live here rather than in .env.local so the tool can be
/// configured from its own UI, without editing files or restarting the server.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One render request and its outcome. Params are stored flat so a history
/// entry can be replayed verbatim without joining anything.
model Render {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// pending | running | succeeded | failed
  status     String @default("pending")
  durationMs Int?
  error      String?

  provider    String
  model       String
  controlMode String

  /// The three prompt axes, stored separately so a history entry can be
  /// replayed or re-composed without re-parsing the flattened prompt.
  presetId  String?
  contextId String?
  lightingId String?

  prompt String
  /// Free text the user added for this project, kept separate from the composed
  /// prompt so a replay can re-compose without losing it.
  extraDetails String?
  /// Lanes per direction the user pinned, null when left to the model.
  lanesPerDirection Int?
  negativePrompt    String?
  controlStrength Float
  strength        Float
  guidanceScale   Float
  steps           Int
  numImages Int
  /// Stored as text, not Int. fal returns seeds far outside JavaScript's safe
  /// integer range (observed: 3156009610848450000), and reading such a row back
  /// throws before Prisma even gets to it.
  seed String?
  width           Int
  height          Int
  /// Longest requested output side in pixels.
  maxSide      Int    @default(1440)
  outputFormat String @default("jpeg")

  /// Path relative to the storage root, e.g. "uploads/abc123.png".
  sourcePath String
  /// JSON array of storage-relative paths for the generated images.
  outputPaths String @default("[]")

  /// User-set flag for pinning good results in the library.
  favorite Boolean @default(false)

  /// --- Region edit -------------------------------------------------------
  /// Set when this render is a masked edit of an earlier one. The chain lets a
  /// result be corrected in several rounds and still be traced back.
  parentId String?
  /// Storage-relative path of the mask, white where the edit was allowed.
  maskPath String?
  /// What the user typed, in whatever language they typed it.
  editInstruction String?
  /// The English the engine actually received, when a translation happened.
  editInstructionEn String?
  /// Region actually sent to the engine, as JSON {left,top,width,height}.
  editBox String?

  @@index([createdAt])
  @@index([status])
  @@index([parentId])
}
