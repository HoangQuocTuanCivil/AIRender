# ---------------------------------------------------------------------------
# Copy file này thành `.env.local` rồi điền key thật. `.env.local` đã bị gitignore.
# ---------------------------------------------------------------------------

# SQLite cho lịch sử render. Không cần đổi khi chạy local.
DATABASE_URL="file:./prisma/dev.db"

# --- Provider (chọn ít nhất 1) ---------------------------------------------

# fal.ai — một key này chạy được CẢ HAI engine:
#   · FLUX.1 dev + ControlNet  (có núm vặn độ bám hình khối)
#   · Nano Banana Pro (Gemini) (giữ nguyên tuyệt đối cấu kiện mảnh)
# Lấy key: https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — phương án dự phòng.
# Lấy token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Engine mặc định: "fal" | "nano-banana" | "replicate".
# Bỏ trống = tự chọn engine đầu tiên có key. UI vẫn cho chọn lại từng lần render.
RENDER_PROVIDER=

# --- Tuỳ chọn nâng cao -----------------------------------------------------

# Ghi đè model endpoint nếu provider đổi slug.
# FAL_MODEL_CANNY=fal-ai/flux-control-lora-canny/image-to-image
# FAL_MODEL_DEPTH=fal-ai/flux-control-lora-depth/image-to-image
# FAL_MODEL_IMG2IMG=fal-ai/flux/dev/image-to-image
# FAL_MODEL_NANO_BANANA=fal-ai/nano-banana-pro/edit
# REPLICATE_MODEL_CANNY=black-forest-labs/flux-canny-dev
# REPLICATE_MODEL_DEPTH=black-forest-labs/flux-depth-dev
# REPLICATE_MODEL_IMG2IMG=black-forest-labs/flux-dev

# Nơi lưu ảnh upload + ảnh render. Mặc định: ./storage
# STORAGE_DIR=D:/02_Projects/AIRender/storage
